# 비워두면 목(mock) 데이터 + 인메모리 캐시로 동작합니다.

# 공공데이터포털 / 서울 실시간 도시데이터 API 키
SEOUL_OPENAPI_KEY=
DATA_GO_KR_KEY=

# 네이버 지도 (NAVER Cloud Maps). Client ID는 브라우저에 노출되는 값,
# Client Secret은 서버 전용(Geocoding·Directions 등 REST API용)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Upstash Redis (REST) — 설정 시 인메모리 대신 Redis 사용
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /api/cron/refresh 보호용 (Vercel Cron 이 Authorization: Bearer 로 전송)
CRON_SECRET=

# 매일 비용 정산 리포트 (/api/cron/cost-report)
# NCP 계정 API 인증키 (마이페이지 → 계정 관리 → 인증키 관리). 지도용 키와 다름
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
# 쉼표로 여러 명. 도메인 인증 전에는 Resend 가입 이메일만 가능
REPORT_EMAIL_TO=
# 회원에게 보내는 메일(자동결제 7일 전 안내) 보내는 사람. Resend에서 crowdview.app 도메인 인증 후 예: CrowdView <noreply@crowdview.app>
MAIL_FROM=
# 운영 도구(/admin)를 쓸 수 있는 로그인 이메일 (쉼표로 여러 명)
ADMIN_EMAILS=

# Papago 번역 (NCP Application)
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_PASSWORD=

# SK open API (openapi.sk.com): TMAP 장소 검색 + 장소 혼잡도. 없으면 꺼짐
SK_OPENAPI_APP_KEY=
# SK 하루 호출 상한 (건당 33원, 기본 30건). Basic 요금제 최대 100
SK_DAILY_LIMIT=

# 회원·구독·결제·알림 DB (표준 Postgres: Neon, Supabase, RDS 등). 만든 뒤 npm run db:migrate
DATABASE_URL=

# 소셜 로그인 (Better Auth). 비밀값: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://crowdview.app
# 카카오 developers → 앱 → REST API 키 / 보안 → Client Secret. Redirect URI: https://crowdview.app/api/auth/callback/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Google Cloud Console → OAuth 클라이언트. 승인된 리디렉션 URI: https://crowdview.app/api/auth/callback/google
# 네이버 로그인 (developers.naver.com → 애플리케이션 등록 → 네이버 로그인, Callback URL: https://crowdview.app/api/auth/callback/naver)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 검색어 트렌드: NCP 콘솔 NAVER API HUB의 Search Trend (개발자센터 데이터랩은 신규 등록 불가). Papago 앱에 Search Trend를 켜면 그 키를 쓴다.
# 다른 NCP 앱 키를 쓰려면 NAVER_DATALAB_CLIENT_ID / NAVER_DATALAB_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 검색엔진 소유 확인 (Search Console / 네이버 서치어드바이저의 meta content 값)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# Bing 웹마스터 도구 → 사이트 추가 → HTML 메타 태그의 content 값 (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# 구글 애드센스 (발행자 ID ca-pub-…, 광고 단위 ID)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=

# 토스페이먼츠 자동결제(빌링) 직접 연동. 개발자센터 → API 키 → "API 개별 연동 키" (결제위젯 키 아님)
# 테스트 키(test_ck_/test_sk_)는 바로 되고, 라이브 키는 토스와 자동결제 계약(심사) 후 발급
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 오류 추적 (Sentry, 무료 Developer 플랜). sentry.io → 프로젝트(Next.js) → Settings → Client Keys (DSN). 없으면 꺼짐
NEXT_PUBLIC_SENTRY_DSN=

# 혼잡 알림 웹 푸시 (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@crowdview.app

# 자료 보관 (Cloudflare R2, S3 호환). 수집기가 5분마다 혼잡도·서울 인구 한 덩어리를 archive/crowd/YYYY/MM/DD/HHmm.ndjson.gz 로 저장.
# R2 대시보드 → 버킷 만들기 → R2 API 토큰(Object Read & Write) 발급. 없으면 보관하지 않음. 다른 S3로 옮기면 R2_ENDPOINT만 바꾼다
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crowdview-archive
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com  (기본값, S3·MinIO로 옮길 때만 지정)
