# 비워두면 목(mock) 데이터 + 인메모리 캐시로 동작합니다.

# 공공데이터포털 / 서울 실시간 도시데이터 API 키
SEOUL_OPENAPI_KEY=
DATA_GO_KR_KEY=

# 네이버 지도 (NAVER Cloud Maps). Client ID는 브라우저에 노출되는 값,
# Client Secret은 서버 전용(Geocoding·Directions 등 REST API용)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Upstash Redis (REST) — 설정 시 인메모리 대신 Redis 사용
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /api/cron/refresh 보호용 (Vercel Cron 이 Authorization: Bearer 로 전송)
CRON_SECRET=

# 매일 비용 정산 리포트 (/api/cron/cost-report)
# NCP 계정 API 인증키 (마이페이지 → 계정 관리 → 인증키 관리). 지도용 키와 다름
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
# 쉼표로 여러 명. 도메인 인증 전에는 Resend 가입 이메일만 가능
REPORT_EMAIL_TO=
