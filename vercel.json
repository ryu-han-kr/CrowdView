{
  "regions": ["icn1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.crowdview.app" }],
      "destination": "https://crowdview.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    { "path": "/api/cron/refresh", "schedule": "0 0 * * *" },
    { "path": "/api/cron/cost-report", "schedule": "0 0 * * *" }
  ]
}
